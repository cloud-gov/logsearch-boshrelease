set -e

# Extract Elasticsearch
tar xzf elasticsearch/elasticsearch-7.17.8-no-jdk-linux-x86_64.tar.gz -C $BOSH_INSTALL_TARGET --strip-components 1

# Create plugins directory and extract plugin
mkdir -p $BOSH_INSTALL_TARGET/plugins/repository-s3
unzip -q elasticsearch/repository-s3-7.17.8.zip -d $BOSH_INSTALL_TARGET/plugins/repository-s3